generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

enum Role {
  user
  assistant
}

model Message {
  id             String       @id @default(cuid())
  role           Role
  content        String
  createdAt      DateTime     @default(now())
  inputTokens    Int?
  outputTokens   Int?
  model          String?
  // 生成这条回复的人格 id（savage / gentle / veteran / plain）。
  //
  // 可空的原因和 model 一样：这一列是后加的，此前入库的消息没有这个值。
  // 加成 NOT NULL 就必须给历史数据编一个默认人格——那等于凭空断言
  // "以前那些回答是 Savage 说的"，是错的。宁可为 null，读的时候不显示头像。
  //
  // 存 id 不存人格名：名字会改（"Straight Up" 就是从 "Assistant" 改来的），
  // id 是稳定标识。历史消息不该因为改了个显示名就对不上。
  persona        String?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// 公开 demo 的调用计数。一张表同时承担两种限流：
//   key = "ip:203.0.113.42"  → 单个来源每小时的额度
//   key = "global"           → 全站每天的总量保险丝
// 靠 key 的前缀区分，省得为两种粒度各建一张表。
//
// windowStart 存的是窗口起点（小时或天对齐后的时间），不是首次请求的时间——
// 对齐之后同一窗口内的所有请求都会命中同一行，upsert 才能原子地累加。
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  // 复合主键：并发请求打到同一行时由数据库串行化，不会各写各的
  @@id([key, windowStart])
  // 清理过期记录时按窗口起点批量删，需要索引
  @@index([windowStart])
}
